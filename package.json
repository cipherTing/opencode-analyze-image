{
  "name": "opencode-analyze-image",
  "version": "0.1.0",
  "description": "OpenCode plugin that lets text-only models analyze image attachments, URLs, files, and directories through an auxiliary vision model.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --external:@opencode-ai/plugin --outfile=dist/index.js",
    "install:local": "npm run build && node scripts/install-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@opencode-ai/plugin": "^1.18.13",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=1.18.13"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "vision",
    "image-analysis",
    "multimodal",
    "openai",
    "anthropic"
  ],
  "license": "MIT"
}
